Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive directories and files
    RewriteRule ^(app|storage|database|docs|tests|vendor|dist|bin|docker)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|\.env\.example|composer\.(json|lock)|setup\.php|router\.php|Dockerfile|render\.yaml)$ - [F,L,NC]
    RewriteRule \.(sql|log)$ - [F,L,NC]

    # Route all /api/* requests to api/index.php
    RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
    RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
